<Window x:Class="AgnesEditImage.FullscreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Maximized"
        Background="Black"
        KeyDown="Window_KeyDown">
  <Grid>
    <Image x:Name="FullscreenImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
      <Image.RenderTransform>
        <MatrixTransform x:Name="ImageTransform"/>
      </Image.RenderTransform>
    </Image>
    <Button Content="✕" Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
            Background="White" Foreground="Black" FontWeight="Bold" Click="Close_Click"/>
  </Grid>
</Window>

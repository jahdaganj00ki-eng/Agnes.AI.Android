<Window x:Class="AgnesEditImage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AgnesEditImage.ViewModels"
        xmlns:m="clr-namespace:AgnesEditImage.Models"
        xmlns:conv="clr-namespace:AgnesEditImage.Converters"
        xmlns:theme="clr-namespace:AgnesEditImage.Theme"
        Title="Agnes Edit Image" Height="720" Width="480"
        Background="{x:Static theme:ThemeColors.AppBackground}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="14">
  <Window.Resources>
    <Style x:Key="PillToggleButton" TargetType="ToggleButton">
      <Setter Property="Background" Value="{x:Static theme:ThemeColors.CardBackground}"/>
      <Setter Property="Foreground" Value="{x:Static theme:ThemeColors.TextPrimary}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{x:Static theme:ThemeColors.UserBubble}"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="UserMessageTemplate" DataType="{x:Type m:UserMessage}">
      <Border Background="{x:Static theme:ThemeColors.UserBubble}" CornerRadius="18,18,4,18" Padding="12,8" MaxWidth="320" HorizontalAlignment="Right" Margin="0,4,0,4">
        <TextBlock Text="{Binding Text}" Foreground="White" TextWrapping="Wrap"/>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ThoughtGroupTemplate" DataType="{x:Type m:ThoughtGroup}">
      <Border Background="{x:Static theme:ThemeColors.CardBackground}" CornerRadius="16" Padding="12" Margin="0,4,0,4">
        <StackPanel>
          <TextBlock Text="Thoughts complete" Foreground="{x:Static theme:ThemeColors.TextPrimary}" FontWeight="Bold"/>
          <TextBlock Text="{Binding DurationSeconds}" Foreground="{x:Static theme:ThemeColors.TextMuted}" Margin="0,2,0,8"/>
          <ItemsControl ItemsSource="{Binding Skills}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{x:Static theme:ThemeColors.CardBackground2}" CornerRadius="8" Padding="8" Margin="0,0,0,4">
                  <TextBlock Text="{Binding Badge}" Foreground="{x:Static theme:ThemeColors.TextPrimary}"/>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="AssistantTextTemplate" DataType="{x:Type m:AssistantText}">
      <Border Background="{x:Static theme:ThemeColors.CardBackground}" CornerRadius="16" Padding="14" Margin="0,4,0,4">
        <TextBlock Text="{Binding Text}" Foreground="{x:Static theme:ThemeColors.TextPrimary}" TextWrapping="Wrap"/>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="PromptEnhancementTemplate" DataType="{x:Type m:PromptEnhancement}">
      <Border Background="{x:Static theme:ThemeColors.CardBackground}" CornerRadius="16" Padding="14" Margin="0,4,0,4">
        <StackPanel>
          <TextBlock Text="Prompt Enhancement" Foreground="{x:Static theme:ThemeColors.TextPrimary}" FontWeight="Bold"/>
          <TextBlock Text="Review the enhanced prompt before designing" Foreground="{x:Static theme:ThemeColors.TextMuted}" Margin="0,2,0,8"/>
          <Border Background="{x:Static theme:ThemeColors.CardBackground2}" CornerRadius="8" Padding="10">
            <TextBlock Text="{Binding Original}" Foreground="{x:Static theme:ThemeColors.TextPrimary}" TextWrapping="Wrap"/>
          </Border>
          <Border Background="{x:Static theme:ThemeColors.CardBackground2}" CornerRadius="8" Padding="10" Margin="0,4,0,0">
            <TextBlock Text="{Binding Enhanced}" Foreground="{x:Static theme:ThemeColors.TextPrimary}" TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="StatusBannerTemplate" DataType="{x:Type m:StatusBanner}">
      <Border Background="{x:Static theme:ThemeColors.CardBackground2}" CornerRadius="14" Padding="12" Margin="0,4,0,4">
        <TextBlock Text="{Binding Text}" Foreground="{x:Static theme:ThemeColors.TextMuted}"/>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ResultImageTemplate" DataType="{x:Type m:ResultImage}">
      <Border Background="{x:Static theme:ThemeColors.CardBackground}" CornerRadius="16" Margin="0,4,0,4">
        <Grid>
          <Image Source="{Binding Bytes, Converter={x:Static conv:ByteArrayToImageConverter.Instance}}" Stretch="Uniform" MaxHeight="400"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12">
            <Button Content="Bearbeiten" Width="120" Height="36" Background="{x:Static theme:ThemeColors.UserBubble}" Foreground="White" BorderThickness="0" CornerRadius="8" FontWeight="SemiBold" Command="{Binding DataContext.UseAsInputCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Bytes}"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ErrorTemplate" DataType="{x:Type m:ErrorItem}">
      <Border Background="{x:Static theme:ThemeColors.CardBackground}" CornerRadius="16" Padding="14" Margin="0,4,0,4">
        <TextBlock Text="{Binding Message}" Foreground="{x:Static theme:ThemeColors.ErrorRed}" TextWrapping="Wrap"/>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="AttachmentThumbnailTemplate" DataType="{x:Type m:Attachment}">
      <Border Width="56" Height="56" CornerRadius="10" Margin="0,0,8,0" ClipToBounds="True" Background="{x:Static theme:ThemeColors.CardBackground2}">
        <Grid>
          <Image Stretch="UniformToFill" Source="{Binding Converter={x:Static conv:AttachmentToImageConverter.Instance}}"/>
          <Button Content="✕" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2" Padding="0" Background="#CC000000" Foreground="White" BorderThickness="0" FontSize="10" FontWeight="Bold" Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
        </Grid>
      </Border>
    </DataTemplate>

    <conv:ChatItemTemplateSelector x:Key="ChatSelector"
      UserMessageTemplate="{StaticResource UserMessageTemplate}"
      ThoughtGroupTemplate="{StaticResource ThoughtGroupTemplate}"
      AssistantTextTemplate="{StaticResource AssistantTextTemplate}"
      PromptEnhancementTemplate="{StaticResource PromptEnhancementTemplate}"
      StatusBannerTemplate="{StaticResource StatusBannerTemplate}"
      ResultImageTemplate="{StaticResource ResultImageTemplate}"
      ErrorTemplate="{StaticResource ErrorTemplate}"/>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Left" Width="60" Background="#E91E63" Padding="8">
      <StackPanel>
        <Border Width="44" Height="44" CornerRadius="10" Margin="0,0,0,12" Background="White">
          <Image Source="/Images/biglogo.png" Stretch="Uniform"/>
        </Border>
        <TextBlock Text="Agnes AI Studio" Foreground="White" FontWeight="Bold" FontSize="10" TextAlignment="Center" Margin="0,0,0,12"/>
        <Button Content="☰" Width="36" Height="36" Background="Transparent" Foreground="White" FontSize="18" Padding="0" Click="Menu_Click" ToolTip="Einstellungen"/>
        <Button Content="＋" Width="36" Height="36" Background="Transparent" Foreground="White" FontSize="18" Padding="0" Click="NewChat_Click" ToolTip="Neue Unterhaltung" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Background="{x:Static theme:ThemeColors.CardBackground}" Padding="12,10" BorderBrush="{x:Static theme:ThemeColors.CardBackground2}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Edit Images" Foreground="{x:Static theme:ThemeColors.TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="1" Width="160" Height="32" Background="{x:Static theme:ThemeColors.CardBackground2}" Foreground="{x:Static theme:ThemeColors.TextPrimary}" BorderThickness="0" Padding="8,0">
          <ComboBoxItem Content="Qwen3.6-Plus" IsSelected="True"/>
        </ComboBox>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{x:Static theme:ThemeColors.AppBackground}" Padding="12">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Items}" ItemTemplateSelector="{StaticResource ChatSelector}" MinHeight="100"/>

        <ItemsControl ItemsSource="{Binding Attachments}" ItemTemplate="{StaticResource AttachmentThumbnailTemplate}" Margin="0,0,0,10">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Border Background="{x:Static theme:ThemeColors.CardBackground}" CornerRadius="20" Padding="4">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="📎" Width="36" Height="36" Background="Transparent" Foreground="{x:Static theme:ThemeColors.TextPrimary}" Click="Attach_Click" Padding="0" ToolTip="Bild hinzufügen"/>
            <TextBox Grid.Column="1" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Height="40" Background="Transparent" BorderThickness="0" Foreground="{x:Static theme:ThemeColors.TextPrimary}" VerticalContentAlignment="Center" Margin="8,0" Padding="4,0"/>
            <Button Grid.Column="2" Content="➤" Width="36" Height="36" Background="Transparent" Foreground="{x:Static theme:ThemeColors.TextPrimary}" Command="{Binding SubmitCommand}" Padding="0" ToolTip="Senden"/>
          </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
          <ToggleButton Content="Edit Image" IsChecked="{Binding Mode, Converter={x:Static conv:ModeToBoolConverter.Instance}, ConverterParameter=edit}" Command="{Binding SetModeCommand}" CommandParameter="edit" Style="{StaticResource PillToggleButton}" Margin="0,0,6,0"/>
          <ToggleButton Content="Full Body" IsChecked="{Binding Mode, Converter={x:Static conv:ModeToBoolConverter.Instance}, ConverterParameter=full_body}" Command="{Binding SetModeCommand}" CommandParameter="full_body" Style="{StaticResource PillToggleButton}" Margin="0,0,6,0"/>
          <ToggleButton Content="Try-On" IsEnabled="False" Style="{StaticResource PillToggleButton}" Margin="0,0,6,0" ToolTip="Demnächst verfügbar"/>
          <ToggleButton Content="Enhance" IsChecked="{Binding Mode, Converter={x:Static conv:ModeToBoolConverter.Instance}, ConverterParameter=enhance}" Command="{Binding SetModeCommand}" CommandParameter="enhance" Style="{StaticResource PillToggleButton}" Margin="0,0,6,0"/>
          <ToggleButton Content="Black BG" IsChecked="{Binding Mode, Converter={x:Static conv:ModeToBoolConverter.Instance}, ConverterParameter=black_bg}" Command="{Binding SetModeCommand}" CommandParameter="black_bg" Style="{StaticResource PillToggleButton}"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </DockPanel>
</Window>

<Window x:Class="AgnesEditImage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AgnesEditImage.ViewModels"
        xmlns:m="clr-namespace:AgnesEditImage.Models"
        xmlns:conv="clr-namespace:AgnesEditImage.Converters"
        xmlns:theme="clr-namespace:AgnesEditImage.Theme"
        Title="Agnes Edit Image" Height="720" Width="480"
        Background="{x:Static theme:ThemeColors.AppBackground}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13">
  <Window.Resources>
    <DataTemplate x:Key="UserMessageTemplate" DataType="{x:Type m:UserMessage}">
      <Border Background="{x:Static theme:ThemeColors.UserBubble}" CornerRadius="18,18,4,18" Padding="10,8" MaxWidth="280" HorizontalAlignment="Right" Margin="8,4">
        <TextBlock Text="{Binding Text}" Foreground="White" TextWrapping="Wrap" FontSize="13"/>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ThoughtGroupTemplate" DataType="{x:Type m:ThoughtGroup}">
      <Border Background="{x:Static theme:ThemeColors.CardBackground}" CornerRadius="14" Padding="10" Margin="8,4" HorizontalAlignment="Left">
        <StackPanel>
          <TextBlock Text="Thoughts complete" Foreground="{x:Static theme:ThemeColors.TextPrimary}" FontWeight="Bold" FontSize="12"/>
          <TextBlock Text="{Binding DurationSeconds}" Foreground="{x:Static theme:ThemeColors.TextMuted}" Margin="0,2,0,6" FontSize="11"/>
          <ItemsControl ItemsSource="{Binding Skills}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{x:Static theme:ThemeColors.CardBackground2}" CornerRadius="6" Padding="4,2" Margin="0,0,4,4">
                  <TextBlock Text="{Binding Badge}" Foreground="{x:Static theme:ThemeColors.TextPrimary}" FontSize="11"/>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="AssistantTextTemplate" DataType="{x:Type m:AssistantText}">
      <Border Background="{x:Static theme:ThemeColors.CardBackground}" CornerRadius="14" Padding="12" Margin="8,4" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Text}" Foreground="{x:Static theme:ThemeColors.TextPrimary}" TextWrapping="Wrap" FontSize="13"/>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="PromptEnhancementTemplate" DataType="{x:Type m:PromptEnhancement}">
      <Border Background="{x:Static theme:ThemeColors.CardBackground}" CornerRadius="14" Padding="12" Margin="8,4" HorizontalAlignment="Left">
        <StackPanel>
          <TextBlock Text="Prompt Enhancement" Foreground="{x:Static theme:ThemeColors.TextPrimary}" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
          <TextBlock Text="Review the enhanced prompt before designing" Foreground="{x:Static theme:ThemeColors.TextMuted}" FontSize="11" Margin="0,0,0,6"/>
          <Border Background="{x:Static theme:ThemeColors.CardBackground2}" CornerRadius="8" Padding="8" Margin="0,0,0,6">
            <TextBlock Text="{Binding Original}" Foreground="{x:Static theme:ThemeColors.TextPrimary}" TextWrapping="Wrap" FontSize="12"/>
          </Border>
          <Border Background="{x:Static theme:ThemeColors.CardBackground2}" CornerRadius="8" Padding="8">
            <TextBlock Text="{Binding Enhanced}" Foreground="{x:Static theme:ThemeColors.TextPrimary}" TextWrapping="Wrap" FontSize="12"/>
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="StatusBannerTemplate" DataType="{x:Type m:StatusBanner}">
      <Border Background="{x:Static theme:ThemeColors.CardBackground2}" CornerRadius="12" Padding="10" Margin="8,4" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Text}" Foreground="{x:Static theme:ThemeColors.TextMuted}" FontSize="12"/>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ResultImageTemplate" DataType="{x:Type m:ResultImage}">
      <Border Background="{x:Static theme:ThemeColors.CardBackground}" CornerRadius="14" Margin="8,4" HorizontalAlignment="Left">
        <StackPanel>
          <Image Source="{Binding Bytes, Converter={x:Static conv:ByteArrayToImageConverter.Instance}}" Stretch="Uniform" MaxHeight="320"/>
          <Button Content="Bearbeiten" Background="{x:Static theme:ThemeColors.CardBackground2}" Foreground="{x:Static theme:ThemeColors.TextPrimary}" BorderThickness="0" Padding="8,4" Margin="0,8,0,0" HorizontalAlignment="Left" FontSize="12" Click="EditResult_Click"/>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ErrorTemplate" DataType="{x:Type m:ErrorItem}">
      <Border Background="{x:Static theme:ThemeColors.CardBackground}" CornerRadius="14" Padding="12" Margin="8,4" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Message}" Foreground="{x:Static theme:ThemeColors.ErrorRed}" TextWrapping="Wrap" FontSize="13"/>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="AttachmentThumbnailTemplate" DataType="{x:Type m:Attachment}">
      <Border Width="52" Height="52" CornerRadius="10" Margin="0,0,6,0" ClipToBounds="True" Background="{x:Static theme:ThemeColors.CardBackground2}">
        <Grid>
          <Image Stretch="UniformToFill" Source="{Binding Converter={x:Static conv:AttachmentToImageConverter.Instance}}"/>
          <Button Content="✕" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="1" Padding="0" Background="#AA000000" Foreground="White" BorderThickness="0" FontSize="9" FontWeight="Bold" Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
        </Grid>
      </Border>
    </DataTemplate>

    <conv:ChatItemTemplateSelector x:Key="ChatSelector"
      UserMessageTemplate="{StaticResource UserMessageTemplate}"
      ThoughtGroupTemplate="{StaticResource ThoughtGroupTemplate}"
      AssistantTextTemplate="{StaticResource AssistantTextTemplate}"
      PromptEnhancementTemplate="{StaticResource PromptEnhancementTemplate}"
      StatusBannerTemplate="{StaticResource StatusBannerTemplate}"
      ResultImageTemplate="{StaticResource ResultImageTemplate}"
      ErrorTemplate="{StaticResource ErrorTemplate}"/>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{x:Static theme:ThemeColors.AppBackground}" Padding="10,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Width="32" Height="32" Background="Transparent" Foreground="{x:Static theme:ThemeColors.TextPrimary}" FontSize="16" Padding="0" Click="Menu_Click">
          <Image Source="/Images/biglogo.png" Width="20" Height="20"/>
        </Button>
        <TextBlock Grid.Column="1" Text="Agnes AI Studio" Foreground="{x:Static theme:ThemeColors.TextPrimary}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="8,0,0,0"/>
        <Button Grid.Column="2" Width="32" Height="32" Background="Transparent" Foreground="{x:Static theme:ThemeColors.TextPrimary}" FontSize="18" Padding="0" Click="NewChat_Click">＋</Button>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{x:Static theme:ThemeColors.AppBackground}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4">
        <ItemsControl ItemsSource="{Binding Items}" ItemTemplateSelector="{StaticResource ChatSelector}"/>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="2" Background="{x:Static theme:ThemeColors.AppBackground}" Padding="10,8">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Attachments}" ItemTemplate="{StaticResource AttachmentThumbnailTemplate}" Margin="0,0,0,8">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Border Background="{x:Static theme:ThemeColors.CardBackground}" CornerRadius="22" Padding="6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Width="34" Height="34" Background="Transparent" Foreground="{x:Static theme:ThemeColors.TextPrimary}" Click="Attach_Click" Padding="0" ToolTip="Bild hinzufügen">
              <Image Source="/Images/biglogo.png" Width="18" Height="18"/>
            </Button>
            <TextBox Grid.Column="1" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Height="38" Background="Transparent" BorderThickness="0" Foreground="{x:Static theme:ThemeColors.TextPrimary}" VerticalContentAlignment="Center" Margin="8,0" Padding="4,0" FontSize="13"/>
            <Button Grid.Column="2" Width="34" Height="34" Background="Transparent" Foreground="{x:Static theme:ThemeColors.TextPrimary}" Command="{Binding SubmitCommand}" Padding="0" ToolTip="Senden">
              <Path Data="M2,21 L23,12 L2,3" Stroke="{x:Static theme:ThemeColors.TextPrimary}" StrokeThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
          </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
          <ToggleButton Content="Edit Image" IsChecked="{Binding Mode, Converter={x:Static conv:ModeToBoolConverter.Instance}, ConverterParameter=edit}" Command="{Binding SetModeCommand}" CommandParameter="edit" Background="{x:Static theme:ThemeColors.CardBackground}" Foreground="{x:Static theme:ThemeColors.TextPrimary}" Margin="0,0,4,0" Padding="10,6" BorderThickness="0" CornerRadius="8" FontSize="12"/>
          <ToggleButton Content="Full Body" IsChecked="{Binding Mode, Converter={x:Static conv:ModeToBoolConverter.Instance}, ConverterParameter=full_body}" Command="{Binding SetModeCommand}" CommandParameter="full_body" Background="{x:Static theme:ThemeColors.CardBackground}" Foreground="{x:Static theme:ThemeColors.TextPrimary}" Margin="0,0,4,0" Padding="10,6" BorderThickness="0" CornerRadius="8" FontSize="12"/>
          <ToggleButton Content="Try-On" IsEnabled="False" Background="{x:Static theme:ThemeColors.CardBackground}" Foreground="{x:Static theme:ThemeColors.TextMuted}" Margin="0,0,4,0" Padding="10,6" BorderThickness="0" CornerRadius="8" FontSize="12" ToolTip="Demnächst verfügbar"/>
          <ToggleButton Content="Enhance" IsChecked="{Binding Mode, Converter={x:Static conv:ModeToBoolConverter.Instance}, ConverterParameter=enhance}" Command="{Binding SetModeCommand}" CommandParameter="enhance" Background="{x:Static theme:ThemeColors.CardBackground}" Foreground="{x:Static theme:ThemeColors.TextPrimary}" Margin="0,0,4,0" Padding="10,6" BorderThickness="0" CornerRadius="8" FontSize="12"/>
          <ToggleButton Content="Black BG" IsChecked="{Binding Mode, Converter={x:Static conv:ModeToBoolConverter.Instance}, ConverterParameter=black_bg}" Command="{Binding SetModeCommand}" CommandParameter="black_bg" Background="{x:Static theme:ThemeColors.CardBackground}" Foreground="{x:Static theme:ThemeColors.TextPrimary}" Padding="10,6" BorderThickness="0" CornerRadius="8" FontSize="12"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>

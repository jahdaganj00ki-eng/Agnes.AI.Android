<Window x:Class="AgnesEditImage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AgnesEditImage.ViewModels"
        xmlns:m="clr-namespace:AgnesEditImage.Models"
        xmlns:conv="clr-namespace:AgnesEditImage.Converters"
        xmlns:theme="clr-namespace:AgnesEditImage.Theme"
        Title="Agnes Edit Image" Height="720" Width="480"
        Background="{x:Static theme:ThemeColors.AppBackground}"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate x:Key="UserMessageTemplate" DataType="{x:Type m:UserMessage}">
      <Border Background="{x:Static theme:ThemeColors.UserBubble}" CornerRadius="18,18,4,18" Padding="12,8" MaxWidth="320" HorizontalAlignment="Right" Margin="0,4,0,4">
        <TextBlock Text="{Binding Text}" Foreground="White" TextWrapping="Wrap"/>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ThoughtGroupTemplate" DataType="{x:Type m:ThoughtGroup}">
      <Border Background="{x:Static theme:ThemeColors.CardBackground}" CornerRadius="16" Padding="12" Margin="0,4,0,4">
        <StackPanel>
          <TextBlock Text="Thoughts complete" Foreground="{x:Static theme:ThemeColors.TextPrimary}" FontWeight="Bold"/>
          <TextBlock Text="{Binding DurationSeconds}" Foreground="{x:Static theme:ThemeColors.TextMuted}" Margin="0,2,0,8"/>
          <ItemsControl ItemsSource="{Binding Skills}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{x:Static theme:ThemeColors.CardBackground2}" CornerRadius="8" Padding="8" Margin="0,0,0,4">
                  <TextBlock Text="{Binding Badge}" Foreground="{x:Static theme:ThemeColors.TextPrimary}"/>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="AssistantTextTemplate" DataType="{x:Type m:AssistantText}">
      <Border Background="{x:Static theme:ThemeColors.CardBackground}" CornerRadius="16" Padding="14" Margin="0,4,0,4">
        <TextBlock Text="{Binding Text}" Foreground="{x:Static theme:ThemeColors.TextPrimary}" TextWrapping="Wrap"/>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="PromptEnhancementTemplate" DataType="{x:Type m:PromptEnhancement}">
      <Border Background="{x:Static theme:ThemeColors.CardBackground}" CornerRadius="16" Padding="14" Margin="0,4,0,4">
        <StackPanel>
          <TextBlock Text="Prompt Enhancement" Foreground="{x:Static theme:ThemeColors.TextPrimary}" FontWeight="Bold"/>
          <TextBlock Text="Review the enhanced prompt before designing" Foreground="{x:Static theme:ThemeColors.TextMuted}" Margin="0,2,0,8"/>
          <Border Background="{x:Static theme:ThemeColors.CardBackground2}" CornerRadius="8" Padding="10">
            <TextBlock Text="{Binding Original}" Foreground="{x:Static theme:ThemeColors.TextPrimary}" TextWrapping="Wrap"/>
          </Border>
          <Border Background="{x:Static theme:ThemeColors.CardBackground2}" CornerRadius="8" Padding="10" Margin="0,4,0,0">
            <TextBlock Text="{Binding Enhanced}" Foreground="{x:Static theme:ThemeColors.TextPrimary}" TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="StatusBannerTemplate" DataType="{x:Type m:StatusBanner}">
      <Border Background="{x:Static theme:ThemeColors.CardBackground2}" CornerRadius="14" Padding="12" Margin="0,4,0,4">
        <TextBlock Text="{Binding Text}" Foreground="{x:Static theme:ThemeColors.TextMuted}"/>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ResultImageTemplate" DataType="{x:Type m:ResultImage}">
      <Border Background="{x:Static theme:ThemeColors.CardBackground}" CornerRadius="16" Margin="0,4,0,4">
        <Image Source="{Binding Bytes, Converter={x:Static conv:ByteArrayToImageConverter.Instance}}" Stretch="Uniform" MaxHeight="400"/>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ErrorTemplate" DataType="{x:Type m:ErrorItem}">
      <Border Background="{x:Static theme:ThemeColors.CardBackground}" CornerRadius="16" Padding="14" Margin="0,4,0,4">
        <TextBlock Text="{Binding Message}" Foreground="{x:Static theme:ThemeColors.ErrorRed}" TextWrapping="Wrap"/>
      </Border>
    </DataTemplate>

    <conv:ChatItemTemplateSelector x:Key="ChatSelector"
      UserMessageTemplate="{StaticResource UserMessageTemplate}"
      ThoughtGroupTemplate="{StaticResource ThoughtGroupTemplate}"
      AssistantTextTemplate="{StaticResource AssistantTextTemplate}"
      PromptEnhancementTemplate="{StaticResource PromptEnhancementTemplate}"
      StatusBannerTemplate="{StaticResource StatusBannerTemplate}"
      ResultImageTemplate="{StaticResource ResultImageTemplate}"
      ErrorTemplate="{StaticResource ErrorTemplate}"/>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{x:Static theme:ThemeColors.AppBackground}" Padding="8,4">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="☰" Width="40" Height="40" Background="Transparent" Foreground="{x:Static theme:ThemeColors.TextPrimary}" FontSize="20" Click="Menu_Click"/>
        <TextBlock Text="{Binding Title}" Foreground="{x:Static theme:ThemeColors.TextPrimary}" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <Button Content="＋" Width="40" Height="40" Background="Transparent" Foreground="{x:Static theme:ThemeColors.TextPrimary}" FontSize="20" HorizontalAlignment="Right" Click="NewChat_Click"/>
      </StackPanel>
    </Border>

    <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" Height="Auto">
      <ItemsControl ItemsSource="{Binding Items}" ItemTemplateSelector="{StaticResource ChatSelector}"/>
    </ScrollViewer>

    <Border DockPanel.Dock="Bottom" Background="{x:Static theme:ThemeColors.AppBackground}" Padding="8">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <ToggleButton Content="Edit Image" IsChecked="{Binding Mode, Converter={x:Static conv:ModeToBoolConverter.Instance}, ConverterParameter=edit}" Command="{Binding SetModeCommand}" CommandParameter="edit" Background="{x:Static theme:ThemeColors.CardBackground}" Foreground="{x:Static theme:ThemeColors.TextPrimary}" Margin="0,0,4,0"/>
          <ToggleButton Content="Full Body" IsChecked="{Binding Mode, Converter={x:Static conv:ModeToBoolConverter.Instance}, ConverterParameter=full_body}" Command="{Binding SetModeCommand}" CommandParameter="full_body" Background="{x:Static theme:ThemeColors.CardBackground}" Foreground="{x:Static theme:ThemeColors.TextPrimary}" Margin="0,0,4,0"/>
          <ToggleButton Content="Try-On" IsEnabled="False" Background="{x:Static theme:ThemeColors.CardBackground}" Foreground="{x:Static theme:ThemeColors.TextMuted}" Margin="0,0,4,0" ToolTip="Demnächst verfügbar"/>
          <ToggleButton Content="Enhance" IsChecked="{Binding Mode, Converter={x:Static conv:ModeToBoolConverter.Instance}, ConverterParameter=enhance}" Command="{Binding SetModeCommand}" CommandParameter="enhance" Background="{x:Static theme:ThemeColors.CardBackground}" Foreground="{x:Static theme:ThemeColors.TextPrimary}" Margin="0,0,4,0"/>
          <ToggleButton Content="Black BG" IsChecked="{Binding Mode, Converter={x:Static conv:ModeToBoolConverter.Instance}, ConverterParameter=black_bg}" Command="{Binding SetModeCommand}" CommandParameter="black_bg" Background="{x:Static theme:ThemeColors.CardBackground}" Foreground="{x:Static theme:ThemeColors.TextPrimary}"/>
        </StackPanel>

        <Border Background="{x:Static theme:ThemeColors.CardBackground}" CornerRadius="24" Padding="8">
          <StackPanel Orientation="Horizontal">
            <Button Content="📎" Width="40" Height="40" Background="Transparent" Foreground="{x:Static theme:ThemeColors.TextPrimary}" Click="Attach_Click"/>
            <Button Content="🔗" Width="40" Height="40" Background="Transparent" Foreground="{x:Static theme:ThemeColors.TextPrimary}" Click="AttachUrl_Click"/>
            <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Height="40" Background="Transparent" BorderThickness="0" Foreground="{x:Static theme:ThemeColors.TextPrimary}" VerticalContentAlignment="Center" Margin="8,0"/>
            <Button Content="➤" Width="40" Height="40" Background="Transparent" Foreground="{x:Static theme:ThemeColors.TextPrimary}" Command="{Binding SubmitCommand}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </DockPanel>
</Window>

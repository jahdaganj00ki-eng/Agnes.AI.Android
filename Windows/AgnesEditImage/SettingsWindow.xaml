<Window x:Class="AgnesEditImage.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen" Height="380" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{x:Static AgnesEditImage.Theme:ThemeColors.AppBackground}">
  <StackPanel Margin="24" VerticalAlignment="Center">
    <TextBlock Text="Einstellungen" FontSize="20" FontWeight="Bold" Foreground="{x:Static AgnesEditImage.Theme:ThemeColors.TextPrimary}" Margin="0,0,0,20"/>

    <TextBlock Text="Agnes API Key (wird nur auf diesem Gerät gespeichert):" Foreground="{x:Static AgnesEditImage.Theme:ThemeColors.TextPrimary}" Margin="0,0,0,6"/>
    <PasswordBox x:Name="ApiKeyBox" Height="32" Background="{x:Static AgnesEditImage.Theme:ThemeColors.CardBackground2}" Foreground="{x:Static AgnesEditImage.Theme:ThemeColors.TextPrimary}" BorderBrush="{x:Static AgnesEditImage.Theme:ThemeColors.TextMuted}"/>

    <TextBlock Text="Base URL:" Foreground="{x:Static AgnesEditImage.Theme:ThemeColors.TextPrimary}" Margin="0,16,0,6"/>
    <TextBox x:Name="BaseUrlBox" Height="32" Background="{x:Static AgnesEditImage.Theme:ThemeColors.CardBackground2}" Foreground="{x:Static AgnesEditImage.Theme:ThemeColors.TextPrimary}" BorderBrush="{x:Static AgnesEditImage.Theme:ThemeColors.TextMuted}" Text="https://apihub.agnes-ai.com/v1"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="Abbrechen" Width="100" Height="36" Margin="0,0,8,0" Click="Cancel_Click" Background="{x:Static AgnesEditImage.Theme:ThemeColors.CardBackground2}" Foreground="{x:Static AgnesEditImage.Theme:ThemeColors.TextPrimary}"/>
      <Button Content="Speichern" Width="100" Height="36" Click="Save_Click" Background="White" Foreground="Black"/>
    </StackPanel>
  </StackPanel>
</Window>

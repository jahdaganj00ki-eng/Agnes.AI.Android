<Window x:Class="AgnesEditImage.UrlInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bild per URL hinzufügen" Height="180" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{x:Static AgnesEditImage.Theme:ThemeColors.AppBackground}">
  <StackPanel Margin="20" VerticalAlignment="Center">
    <TextBlock Text="Bild-URL eingeben:" Foreground="{x:Static AgnesEditImage.Theme:ThemeColors.TextPrimary}" Margin="0,0,0,8"/>
    <TextBox x:Name="UrlTextBox" Height="30" Background="{x:Static AgnesEditImage.Theme:ThemeColors.CardBackground2}" Foreground="{x:Static AgnesEditImage.Theme:ThemeColors.TextPrimary}" BorderBrush="{x:Static AgnesEditImage.Theme:ThemeColors.TextMuted}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Abbrechen" Width="100" Height="32" Margin="0,0,8,0" Click="Cancel_Click" Background="{x:Static AgnesEditImage.Theme:ThemeColors.CardBackground2}" Foreground="{x:Static AgnesEditImage.Theme:ThemeColors.TextPrimary}"/>
      <Button Content="Hinzufügen" Width="100" Height="32" Click="Add_Click" Background="White" Foreground="Black"/>
    </StackPanel>
  </StackPanel>
</Window>
